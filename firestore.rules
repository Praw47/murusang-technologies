rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'kdprawin@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /siteContent/published {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteContent/{documentId} {
      allow read, write: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'businessName',
          'serviceCategory',
          'budget',
          'projectDescription',
          'expectedDeliveryDate',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() <= 160
        && request.resource.data.serviceCategory is string
        && request.resource.data.serviceCategory.size() <= 120
        && request.resource.data.budget is string
        && request.resource.data.budget.size() <= 120
        && request.resource.data.projectDescription is string
        && request.resource.data.projectDescription.size() <= 5000
        && request.resource.data.expectedDeliveryDate is string
        && request.resource.data.expectedDeliveryDate.size() <= 40
        && request.resource.data.createdAt == request.time;

      allow get, list, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
